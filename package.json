{
  "name": "professional-invoice-utility",
  "version": "1.1.0",
  "description": "Offline generic professional invoice utility",
  "author": "CA Utility",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "electron .",
    "build": "electron-packager . \"CA Invoice Utility\" --platform=win32 --arch=x64 --out=dist --overwrite --no-asar --ignore=\"^/dist$\" --ignore=\"^/installer$\" --ignore=\"^\\.claude$\" --ignore=\"\\.zip$\"",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "axios": "^1.14.0",
    "cors": "^2.8.5",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "node-machine-id": "^1.1.12",
    "nodemailer": "^9.0.3",
    "puppeteer": "^24.38.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^41.0.2",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.cautility.invoiceutility",
    "productName": "CA Invoice Utility",
    "copyright": "Copyright © CA Utility",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "reminder-scheduler.js",
      "admin-auth.js",
      "license-manager.js",
      "app/**/*",
      "scripts/**/*",
      "WA Automation/**/*",
      "wa_automation_launcher2.ps1",
      "node_modules/**/*",
      "!**/*.map",
      "!dist/**/*",
      "!installer/**/*",
      "!.claude/**/*",
      "!**/*.zip"
    ],
    "asar": false,
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CA Invoice Utility",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "riskeviteHR",
        "repo": "Billing-Automator"
      }
    ]
  }
}
